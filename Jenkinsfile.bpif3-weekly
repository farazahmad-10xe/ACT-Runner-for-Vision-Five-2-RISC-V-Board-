pipeline {
    agent {
        node {
            label 'built-in'
            customWorkspace '/home/lpt-10xe/jenkins-workspaces/bpif3-privileged-weekly'
        }
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '8', artifactNumToKeepStr: '8'))
        timeout(time: 120, unit: 'HOURS')
        timestamps()
        skipDefaultCheckout(true)
    }

    triggers {
        // Automatic runs generate, validate with Sail, and package only.
        // Hardware remains an explicit parameter plus two physical gates.
        cron('H H * * 0')
    }

    parameters {
        string(name: 'RUNNER_BRANCH', defaultValue: 'main',
            description: 'Firmware/runner branch resolved once at the start of the run.')
        string(name: 'RUNNER_REVISION_OVERRIDE', defaultValue: '',
            description: 'Optional exact firmware commit for reproduction.')
        string(name: 'ACT_BRANCH', defaultValue: 'sifive_u74',
            description: 'Merged ACT 4.1 branch containing the Sail 0.14 BPI-F3 configuration.')
        string(name: 'ACT_REVISION_OVERRIDE', defaultValue: '',
            description: 'Optional exact ACT commit for reproduction.')
        booleanParam(name: 'REGENERATE_TESTS', defaultValue: true,
            description: 'Regenerate all scalar, vector, and privileged testgen suites.')
        booleanParam(name: 'RUN_SPIKE', defaultValue: false,
            description: 'Optional Spike screen; disabled by default because the existing Spike profile is VF2/U74-specific.')
        booleanParam(name: 'RUN_HARDWARE', defaultValue: false,
            description: 'Flash and execute on BPI-F3. Requires its SD card, UART and smart plug to be connected.')
        string(name: 'SD_DEV', defaultValue: '/dev/sda', description: 'Dedicated BPI-F3 SD-card device.')
        string(name: 'SERIAL_DEV', defaultValue: '/dev/ttyUSB0', description: 'BPI-F3 UART device.')
        string(name: 'CAPTURE_TIMEOUT', defaultValue: '345600', description: 'Maximum UART capture time in seconds (default: 96 hours).')
    }

    environment {
        RUNNER_REMOTE_URL = 'https://github.com/farazahmad-10xe/ACT-Runner-for-Vision-Five-2-RISC-V-Board-.git'
        LOCAL_TOOLS_SOURCE = '/home/lpt-10xe/vf2_mmode_fw_Final_version_Verified/tools'
        LOCAL_TUYA_DEVICES_SOURCE = '/home/lpt-10xe/vf2_mmode_fw_Final_version_Verified/devices.json'
        VF2_PRIVILEGED_HELPER_ROOT = '/home/lpt-10xe/vf2_mmode_fw_Final_version_Verified'
        VF2_FLASH_STAGING_ROOT = '/home/lpt-10xe/jenkins-hardware-staging/bpif3-privileged-weekly'
        ACT_REMOTE_URL = 'https://github.com/Arshia2564/riscv-arch-test.git'
        SD_FLASH_ATTEMPTS = '3'
        SD_FLASH_RETRY_DELAY = '10'
        SAIL_BIN = '/home/lpt-10xe/riscv-sail-0.14/bin/sail_riscv_sim'
        SAIL_EXPECTED_VERSION = '0.14'
        PATH = '/home/lpt-10xe/.local/bin:/home/lpt-10xe/riscv64/bin:/home/lpt-10xe/riscv-sail-0.14/bin:/home/lpt-10xe/.rbenv/shims:/home/lpt-10xe/.rbenv/bin:/usr/local/whisper/build-Linux:/home/lpt-10xe/riscv-arch-test/sail-riscv/build/c_emulator:/home/lpt-10xe/sail/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    }

    stages {
        stage('Clean Firmware Checkout') {
            steps {
                deleteDir()
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    branch="${RUNNER_BRANCH:-main}"
                    override="${RUNNER_REVISION_OVERRIDE:-}"
                    git check-ref-format --branch "$branch" >/dev/null
                    git init .
                    git remote add origin "$RUNNER_REMOTE_URL"
                    ref="refs/remotes/origin/$branch"
                    fetch_ok=false
                    for attempt in 1 2 3 4; do
                      echo "Runner fetch attempt ${attempt}/4"
                      if timeout 180 git -c http.lowSpeedLimit=1 \
                        -c http.lowSpeedTime=30 fetch --force --prune origin \
                        "+refs/heads/$branch:$ref"; then
                        fetch_ok=true
                        break
                      fi
                      if [[ "$attempt" -lt 4 ]]; then
                        sleep "$((attempt * 15))"
                      fi
                    done
                    [[ "$fetch_ok" == true ]] || {
                      echo "Unable to fetch runner branch after 4 attempts: $branch" >&2
                      exit 1
                    }
                    fetched="$(git rev-parse --verify "${ref}^{commit}")"
                    revision="$fetched"
                    source="latest-branch-head"
                    if [[ -n "$override" ]]; then
                      revision="$(git rev-parse --verify "${override}^{commit}")"
                      source="override"
                    fi
                    git checkout --detach "$revision"
                    git submodule update --init external/riscv-arch-test
                    mkdir -p tools
                    cp -a "$LOCAL_TOOLS_SOURCE/." tools/
                    test -x tools/act_agent/run_vf2_pack.py
                    test -f tools/act_agent/run_reference_elf.py
                    test -f tools/act_triage/parse_rvcp_log.py
                    if [[ "${RUN_HARDWARE:-false}" == "true" ]]; then
                      test -f "$LOCAL_TUYA_DEVICES_SOURCE"
                      install -m 0600 "$LOCAL_TUYA_DEVICES_SOURCE" devices.json
                      python3 - <<'PY'
import json
from pathlib import Path

data = json.loads(Path("devices.json").read_text())
if isinstance(data, list):
    devices = data
elif isinstance(data, dict) and {"id", "ip", "key"} <= set(data):
    devices = [data]
elif isinstance(data, dict):
    devices = list(data.values())
else:
    devices = []
if not any(
    isinstance(device, dict) and all(device.get(field) for field in ("id", "ip", "key"))
    for device in devices
):
    raise SystemExit("Local Tuya devices file has no complete id/ip/key entry")
print("Validated local Tuya device configuration without displaying credentials.")
PY
                    fi
                    {
                      echo "Runner repository:       $RUNNER_REMOTE_URL"
                      echo "Runner branch:           $branch"
                      echo "Fetched branch SHA:      $fetched"
                      echo "Selected source:         $source"
                      echo "Selected runner SHA:     $revision"
                      echo "Checkout mode:           detached"
                    } | tee .jenkins_runner_resolution.txt
                    test -x ci/jenkins/bpif3_weekly.sh
                    test -x bpif3_act_flash.sh
                '''
            }
        }

        stage('Resolve Latest ACT + Preflight') {
            steps { sh 'ci/jenkins/bpif3_weekly.sh preflight' }
        }

        stage('Generate + Sail + Package') {
            steps { sh 'ci/jenkins/bpif3_weekly.sh prepare' }
        }

        stage('Spike Reference') {
            when { expression { return params.RUN_SPIKE } }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'ci/jenkins/bpif3_weekly.sh spike'
                }
            }
        }

        stage('Attach BPI-F3 SD Card') {
            when { expression { return params.RUN_HARDWARE } }
            steps {
                input message: "Attach the dedicated BPI-F3 SD card as ${params.SD_DEV}. Its OpenSBI partition and ACT tail pack will be overwritten.",
                      ok: 'BPI-F3 SD card is attached'
            }
        }

        stage('Flash BPI-F3') {
            when { expression { return params.RUN_HARDWARE } }
            steps { sh 'ci/jenkins/bpif3_weekly.sh flash' }
        }

        stage('Connect BPI-F3 Hardware') {
            when { expression { return params.RUN_HARDWARE } }
            steps {
                input message: 'Move the SD card to BPI-F3 and connect its UART and power through the configured smart plug. Confirm the VF2 board is disconnected from that plug.',
                      ok: 'BPI-F3 is ready'
            }
        }

        stage('BPI-F3 Execute + Report') {
            when { expression { return params.RUN_HARDWARE } }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'ci/jenkins/bpif3_weekly.sh run'
                }
            }
        }
    }

    post {
        always {
            script {
                if (fileExists('ci/jenkins/bpif3_weekly.sh')) {
                    sh 'ci/jenkins/bpif3_weekly.sh finalize || true'
                }
                def descriptionFile = "logs/jenkins/bpif3-weekly/jenkins_bpif3_weekly_${env.BUILD_NUMBER}/build_description.txt"
                if (fileExists(descriptionFile)) {
                    currentBuild.description = readFile(descriptionFile).trim()
                }
            }
            archiveArtifacts artifacts: "logs/jenkins/bpif3-weekly/jenkins_bpif3_weekly_${env.BUILD_NUMBER}/**, logs/runs/jenkins_bpif3_weekly_${env.BUILD_NUMBER}/**, logs/reference-model-runs/jenkins_bpif3_weekly_${env.BUILD_NUMBER}/**, external/riscv-arch-test/work-bpif3-jenkins-all/bpif3-rva22s64/build/**/*.sig.log, external/riscv-arch-test/work-bpif3-jenkins-all/bpif3-rva22s64/build/**/*.results",
                             allowEmptyArchive: true, fingerprint: false
            publishHTML target: [
                allowMissing: true,
                alwaysLinkToLastBuild: false,
                keepAll: true,
                reportDir: "logs/jenkins/bpif3-weekly/jenkins_bpif3_weekly_${env.BUILD_NUMBER}/site",
                reportFiles: 'index.html',
                reportName: 'BPI-F3 Result Summary',
                reportTitles: 'BPI-F3 K1 All Supported ISA Test Results'
            ]
        }
    }
}
