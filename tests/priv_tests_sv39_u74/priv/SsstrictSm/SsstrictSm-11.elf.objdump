    410000a8:	00810113          	addi	x2,x2,8
    # PMP/MPRV: safe because Ssstrict tests run with full PMP permissions
    # (R=1,W=1,X=1) and address translation disabled, so M-mode can always
    # load from mepc without needing to set mstatus.MPRV.
    # advance = (((bits[1:0]+1) >> 2) + 1) << 1  =  4 if bits[1:0]==0b11, else 2.
    # (bits[1:0]+1)>>2 is 1 only for 0b11; all other values (0b10,0b01,0b00) give 0.
	csrr t0, mepc
    410000ac:	341022f3          	csrrs	x5,mepc,x0
	lhu  t0, 0(t0)                  # load lower 16 bits from *mepc (always 2-byte aligned)
    410000b0:	0002d283          	lhu	x5,0(x5)
	andi t0, t0, 3                  # t0 = bits[1:0]
    410000b4:	0032f293          	andi	x5,x5,3
	addi t0, t0, 1                  # t0 = bits[1:0]+1; equals 4 only when was 0b11
    410000b8:	00128293          	addi	x5,x5,1
	srli t0, t0, 2                  # t0 = 1 iff uncompressed (0b11), else 0
    410000bc:	0022d293          	srli	x5,x5,0x2
	addi t0, t0, 1                  # t0 = 2 or 1
    410000c0:	00128293          	addi	x5,x5,1
	slli t0, t0, 1                  # t0 = 4 (uncompressed) or 2 (compressed)
    410000c4:	00129293          	slli	x5,x5,0x1
	csrr t1, mepc                   # t1 = mepc  (t1 first written here)
    410000c8:	34102373          	csrrs	x6,mepc,x0
	add  t1, t1, t0                 # t1 = mepc + advance
    410000cc:	00530333          	add	x6,x6,x5
	csrw mepc, t1
