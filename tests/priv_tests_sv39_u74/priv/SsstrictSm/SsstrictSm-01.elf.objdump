	addi t0, t0, 1                  # t0 = 2 or 1
    410000c0:	00128293          	addi	x5,x5,1
	slli t0, t0, 1                  # t0 = 4 (uncompressed) or 2 (compressed)
    410000c4:	00129293          	slli	x5,x5,0x1
