# VF2 runner ACT target skeleton
#
# Include this from a target-specific ACT make path, then point
# `VF2_RUNNER_REPO` at the local runner repository.

VF2_RUNNER_REPO ?= /path/to/vf2_mmode_fw
VF2_RUNNER_PRIV ?= M
VF2_RUNNER_DELEG_POLICY ?= DELEGATION_POLICY_NONE
VF2_RUNNER_TOUCH_MENVCFG ?= 0

VF2_RUNNER_ADAPTER_INC := $(VF2_RUNNER_REPO)/act_integration

TARGET_CFLAGS += -I$(VF2_RUNNER_ADAPTER_INC)
TARGET_ASFLAGS += -I$(VF2_RUNNER_ADAPTER_INC)

# Optional helper to build the runner with a matching privilege profile.
vf2-runner-build:
	$(MAKE) -C $(VF2_RUNNER_REPO) -f Makefile.act \
		EXTERNAL_ONLY=1 \
		RUN_PRIV=$(VF2_RUNNER_PRIV) \
		RUNNER_DELEG_POLICY=$(VF2_RUNNER_DELEG_POLICY) \
		RUNNER_TOUCH_MENVCFG=$(VF2_RUNNER_TOUCH_MENVCFG)
