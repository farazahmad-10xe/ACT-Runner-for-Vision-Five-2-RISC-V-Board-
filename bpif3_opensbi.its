/dts-v1/;

/ {
  description = "ACT4 runner firmware for BPI-F3 (SpacemiT K1), replaces the opensbi FIT slot";
  #address-cells = <2>;

  images {
    opensbi {
      description = "bpif3-act4-runner";
      data = /incbin/("firmware_act.bin");
      type = "firmware";
      arch = "riscv";
      os = "opensbi";
      compression = "none";
      load = <0x00 0x04000000>;
      entry = <0x00 0x04000000>;
      hash-1 {
        algo = "crc32";
      };
    };
  };

  configurations {
    default = "config_1";
    config_1 {
      description = "ACT4 runner config";
      firmware = "opensbi";
    };
  };
};
