# ACT non-priv tests in U-mode with S-mode trampoline and compatibility traps.

PROFILE_NAME=ACT_U_COMPAT
PROFILE_STATUS=verified_fdim_sample
PROFILE_NOTES="U-mode ACT profile using S-mode trampoline, private SBI CSR compatibility, and U-mode UART MMIO emulation; T-SBI disabled."

PAYLOAD_PROFILE=ACT
RUN_PRIV=U
EXTERNAL_ONLY=1
RUNNER_DELEG_POLICY=DELEGATION_POLICY_S_BASE
RUNNER_SMODE_CSR_POLICY=RUNNER_SMODE_CSR_POLICY_COMPAT
RUNNER_ENABLE_PRIVATE_SBI=1
RUNNER_ENABLE_TSBI=0
RUNNER_TOUCH_MENVCFG=0

