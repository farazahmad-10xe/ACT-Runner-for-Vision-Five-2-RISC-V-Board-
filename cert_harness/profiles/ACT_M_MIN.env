# ACT non-priv tests in a minimal M-mode execution environment.

PROFILE_NAME=ACT_M_MIN
PROFILE_STATUS=buildable
PROFILE_NOTES="M-mode ACT external-pack profile with lower-mode services disabled."

PAYLOAD_PROFILE=ACT
RUN_PRIV=M
EXTERNAL_ONLY=1
RUNNER_ENABLE_LOWER_MODES=0
RUNNER_ENABLE_TSBI=0
RUNNER_ENABLE_PRIVATE_SBI=0
RUNNER_TOUCH_MENVCFG=0
RUNNER_ASSUME_RVA23_PRIV_FEATURES=0

