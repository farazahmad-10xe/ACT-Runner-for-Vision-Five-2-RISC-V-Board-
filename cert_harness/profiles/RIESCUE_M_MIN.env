# Riescue minimum M-mode environment.

PROFILE_NAME=RIESCUE_M_MIN
PROFILE_STATUS=verification_ongoing
PROFILE_NOTES="Riescue M-mode only; no S/U support because Riescue expects direct M-mode CSR control."

PAYLOAD_PROFILE=RIESCUE
RIESCUE_ELF=special_Tests/maybe_uart_work_1
RUN_PRIV=M
RUNNER_TOUCH_MENVCFG=0
RUNNER_ASSUME_RVA23_PRIV_FEATURES=0
RUNNER_USE_SV39=0
RUNNER_ENABLE_TSBI=0
RUNNER_ENABLE_PRIVATE_SBI=0
RUNNER_VERBOSE_FLOW=0

