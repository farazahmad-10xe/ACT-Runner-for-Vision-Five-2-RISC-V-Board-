# ACT privilege tests with their own M-mode execution environment.

PROFILE_NAME=ACT_PRIV_M_OWN_ENV
PROFILE_STATUS=buildable
PROFILE_NOTES="M-mode ACT profile for privilege tests that manage their own environment."

PAYLOAD_PROFILE=ACT
RUN_PRIV=M
EXTERNAL_ONLY=1
RUNNER_ENABLE_LOWER_MODES=0
RUNNER_ENABLE_TSBI=0
RUNNER_ENABLE_PRIVATE_SBI=0
RUNNER_TOUCH_MENVCFG=0
RUNNER_ASSUME_RVA23_PRIV_FEATURES=0

# Some ACT privilege tests can print repeated RVCP failures without writing
# tohost. Treat no-tohost cases as TIMEOUT, persist progress, and reset quickly
# so the next ELF in the SD-tail pack can run.
RUNNER_TIMEOUT_FAST_RESET=1
RUNNER_TEST_TIMEOUT_TICKS=10000000ULL
RUNNER_RESET_DELAY_TICKS=1000000ULL
RUNNER_MAX_TEST_RETRIES=1u
