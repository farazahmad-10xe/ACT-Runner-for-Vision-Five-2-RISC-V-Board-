# ACT non-priv tests in S-mode with runner private SBI CSR compatibility.

PROFILE_NAME=ACT_S_COMPAT
PROFILE_STATUS=verified_fdim_sample
PROFILE_NOTES="S-mode ACT profile using delegated traps and runner private SBI CSR compatibility; T-SBI disabled."

PAYLOAD_PROFILE=ACT
RUN_PRIV=S
EXTERNAL_ONLY=1
RUNNER_DELEG_POLICY=DELEGATION_POLICY_S_BASE
RUNNER_SMODE_CSR_POLICY=RUNNER_SMODE_CSR_POLICY_COMPAT
RUNNER_ENABLE_PRIVATE_SBI=1
RUNNER_ENABLE_TSBI=0
RUNNER_TOUCH_MENVCFG=0

