# The only runner execution profile supported on this branch.
PROFILE_NAME=UART_M_MODE
PROFILE_STATUS=production
PROFILE_NOTES="M-mode ACT-compatible ELF execution over UART; no embedded or SD payload transport."

RUN_PRIV=M
RUNNER_ENABLE_LOWER_MODES=0
RUNNER_ENABLE_TSBI=0
RUNNER_ENABLE_PRIVATE_SBI=0
RUNNER_TOUCH_MENVCFG=0
RUNNER_ASSUME_RVA23_PRIV_FEATURES=0
