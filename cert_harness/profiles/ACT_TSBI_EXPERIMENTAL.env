# ACT lower-mode T-SBI experiment. Buildable, not certification-verified.

PROFILE_NAME=ACT_TSBI_EXPERIMENTAL
PROFILE_STATUS=experimental_unverified
PROFILE_NOTES="T-SBI-enabled ACT profile; requires T-SBI-specific tests before certification claims."

PAYLOAD_PROFILE=ACT
RUN_PRIV=S
EXTERNAL_ONLY=1
RUNNER_DELEG_POLICY=DELEGATION_POLICY_S_BASE
RUNNER_SMODE_CSR_POLICY=RUNNER_SMODE_CSR_POLICY_COMPAT
RUNNER_ENABLE_PRIVATE_SBI=1
RUNNER_ENABLE_TSBI=1
RUNNER_TOUCH_MENVCFG=0

