# Copy to cert_harness/boards/<board>.env and fill in real values.

BOARD_NAME=my_board
BOARD_DESCRIPTION="Vendor board / SoC"
BOARD_ADAPTER=my_board

# Payload transport choices:
#   sd_tail_pack   - external ACT pack in SD tail footer area
#   embedded_pack  - ACT pack linked into firmware image
#   uart_stream    - reserved for UART payload streaming
#   jtag_load      - reserved for debugger-loaded payloads
#   bootloader_ram - reserved for bootloader-preloaded payloads
BOARD_PAYLOAD_TRANSPORT=embedded_pack

BOARD_LINKER_SCRIPT=link.ld
BOARD_FIT_SOURCE=
BOARD_BOOT_IMAGE=boot_image.bin
BOARD_BOOT_IMAGE_PAD_BYTES=

BOARD_FW_LOAD_ADDR=0x80000000
BOARD_FW_STACK_BYTES=0x4000
BOARD_RAM_BASE=0x80000000
BOARD_RAM_LIMIT=0x88000000

BOARD_UART_BASE=0x10000000
BOARD_UART_SIZE=0x1000
BOARD_CLINT_MSIP_BASE=0x02000000
BOARD_CLINT_MTIMECMP_BASE=0x02004000
BOARD_CLINT_MTIME_ADDR=0x0200bff8
BOARD_RUNNER_HART_ID=0
BOARD_MONITOR_HART_ID=1

BOARD_FIXED_TOHOST_ADDR=0x81008000
BOARD_EXT_PACK_ADDR=0x84000000
BOARD_EXT_PACK_MAX_BYTES=67108864
BOARD_TEST_STACK_BYTES=262144
BOARD_SMODE_RUNTIME_STACK_BYTES=16384
BOARD_TRAP_STACK_BYTES=1024
BOARD_STRAP_STACK_BYTES=1024

# Set to 0 when the board has no SD/MMC transport for payload packs.
BOARD_SD_ENABLE=0
BOARD_SDIO0_BASE=0
BOARD_SDIO1_BASE=0
BOARD_SD_BLOCK_SIZE=512

BOARD_WDT_ENABLE=0
BOARD_WDT_BASE=0
BOARD_WDT_LOAD=0
BOARD_WDT_CTRL=0
BOARD_WDT_LOCK=0
BOARD_WDT_UNLOCK_KEY=0

DEFAULT_SERIAL_DEV=/dev/ttyUSB0
TOOLCHAIN_DIR=
TOOLCHAIN_TRIPLE=riscv64-unknown-elf
