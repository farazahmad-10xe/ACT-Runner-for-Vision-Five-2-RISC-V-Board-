/dts-v1/;

/ {
  description = "Minimal UART ELF runner for JH7110 VisionFive2";
  #address-cells = <1>;

  images {
    firmware {
      description = "vf2-uart-elf-runner";
      data = /incbin/("firmware.bin");
      type = "firmware";
      arch = "riscv";
      os = "u-boot";
      compression = "none";
      load = <0x40000000>;
      entry = <0x40000000>;
    };
  };

  configurations {
    default = "config-1";
    config-1 {
      description = "Minimal UART runner config";
      firmware = "firmware";
    };
  };
};
